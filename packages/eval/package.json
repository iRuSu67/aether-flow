{
  "name": "@aether-flow/eval",
  "version": "1.0.0",
  "description": "Evaluation and benchmarking harness for verified sandbox and dynamic tool synthesis",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node dist/tasks/checkers/run-self-tests.js && node --test dist/tests/*.test.js",
    "test:checkers": "node dist/tasks/checkers/run-self-tests.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aether-flow/core": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
